# ============================================
# SEP — Environment Variables
# Copy file này thành .env và điền giá trị
# ============================================

# --- PostgreSQL 16 ---
POSTGRES_USER=sep
POSTGRES_PASSWORD=123456
POSTGRES_DB=campus_security

# --- MinIO (S3-compatible storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# --- Kafka (KRaft mode) ---
# CLUSTER_ID phải là base64-encoded 16 bytes
# Tạo mới: docker run --rm apache/kafka:3.9.0 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk