# ============================================
# SEP — Environment Variables (Example Template)
# Copy file này thành .env trên máy local/server
# ============================================

# --- Database Host & PostgreSQL 16 ---
DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=sep
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=campus_security

# --- pgAdmin 4 ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123

# --- MinIO (S3-compatible storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# --- Kafka (KRaft mode) ---
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- JWT Security (24 hours expiration = 86400000 ms) ---
JWT_SECRET=your_super_long_jwt_secret_key_here
JWT_EXPIRATION=86400000

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
