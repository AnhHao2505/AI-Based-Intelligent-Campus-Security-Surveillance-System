# Copy thành .env và điền giá trị. KHÔNG commit file .env.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
MINIO_ROOT_USER=
# >= 8 ký tự (AI service bắt buộc)
MINIO_ROOT_PASSWORD=
# MinIO server-side encryption key. Generate your own: echo "icss-key:$(openssl rand -base64 32)"
MINIO_KMS_SECRET_KEY=
JWT_SECRET=
JWT_EXPIRATION=
# >= 32 ký tự (backend không khởi động nếu thiếu)
INTERNAL_SERVICE_KEY=
# Khoá HMAC băm chuỗi đăng nhập sai không khớp tài khoản trong nhật ký audit (>= 32 ký tự, backend không khởi động
# nếu thiếu). Sinh bằng: openssl rand -hex 32. Đổi khoá thì hash cũ không còn so khớp được với hash mới.
APP_SECURITY_AUDITHASHKEY=<set-in-env>
GOOGLE_CLIENT_ID=
# Cấu hình MQTT Broker (Backend đọc MQTT_BROKER_URL, AI service đọc HOST/PORT)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
# Mật khẩu tài khoản MQTT icss-ai / icss-backend, sinh bằng: openssl rand -hex 24
MQTT_AI_PASSWORD=
MQTT_BACKEND_PASSWORD=
# Tùy chọn cấu hình MQTT TLS cho Backend (bỏ comment khi chuyển sang ssl://)
# MQTT_BROKER_URL=ssl://localhost:8883
# MQTT_TRUSTSTORE_PATH=../mosquitto/certs/truststore.jks
# MQTT_TRUSTSTORE_PASSWORD=changeit
# MQTT_TRUSTSTORE_TYPE=JKS
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# Địa chỉ web frontend (link đặt lại mật khẩu); bỏ trống thì dùng http://localhost:5173
APP_FRONTEND_BASE_URL=
# Origin được gọi API, phân tách bằng dấu phẩy; bỏ trống thì dùng các cổng dev 5173, 5174, 3000
APP_CORS_ALLOWED_ORIGINS=
# --- Tùy chọn cấu hình triển khai Cloud-Edge (để trống khi chạy Local/Docker mặc định) ---
# Trên Cloud: đặt AI_SERVICE_URL= và MEDIAMTX_API_URL= (chuỗi rỗng) để điều khiển 100% qua MQTT Outbound-Only
AI_SERVICE_URL=
MEDIAMTX_API_URL=
MEDIAMTX_WHEP_BASE_URL=
# Trên Edge: đặt URL RTSP của Cloud MediaMTX khi muốn bật On-Demand Cloud Stream Relay (FFmpeg -c copy)
CLOUD_MEDIAMTX_RTSP_URL=
# Trên Frontend Cloud: đặt HTTPS WHEP endpoint để tránh lỗi Mixed Content trình duyệt
VITE_CLOUD_WHEP_BASE_URL=
VITE_MEDIAMTX_WHEP_BASE_URL=

AI_CORS_ALLOWED_ORIGINS=

# ==============================================================================
# AI service / Edge (Thiết bị biên Raspberry Pi / Edge Device)
# Các biến BẮT BUỘC hoặc PHẢI ĐỔI khi triển khai thiết bị biên, trỏ lên Cloud Server
# ==============================================================================
# BẮT BUỘC ĐỔI: Định danh duy nhất của từng thiết bị biên trên MQTT Broker (nếu trùng sẽ bị đá nhau)
# MQTT_AI_CLIENT_ID=edge-device-alpha-01
# BẮT BUỘC: URL Backend Cloud để sync khuôn mặt (/api/internal/ai/sync-data) và kiểm tra check-entry
# BACKEND_API_URL=https://cloud.yourdomain.com
# BẮT BUỘC: Khóa xác thực gọi API nội bộ backend (trùng INTERNAL_SERVICE_KEY của Backend, >= 32 ký tự)
# INTERNAL_SERVICE_KEY=<set-in-env>
# BẮT BUỘC: Mật khẩu PostgreSQL (bắt buộc trong config.py; dùng khi worker nạp roi_geometry từ DB)
# POSTGRES_PASSWORD=<set-in-env>
# BẮT BUỘC: Tài khoản MQTT kết nối lên Cloud Broker (icss-ai)
# MQTT_AI_USERNAME=icss-ai
# MQTT_AI_PASSWORD=<set-in-env>
# MediaMTX RTSP cục bộ trên thiết bị biên
# MEDIAMTX_RTSP_URL=rtsp://localhost:8554
# Tùy chọn MQTT TLS trên thiết bị biên (mặc định tắt: port 1883 TCP thuần)
# MQTT_BROKER_PORT=8883
# MQTT_TLS_ENABLED=false
# MQTT_TLS_CA_PATH=../mosquitto/certs/ca.crt
# MQTT_TLS_INSECURE=false
# MQTT_TRANSPORT=tcp

