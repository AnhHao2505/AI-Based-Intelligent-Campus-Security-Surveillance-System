# Copy thành .env và điền giá trị. KHÔNG commit file .env.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
MINIO_ROOT_USER=
# >= 8 ký tự (AI service bắt buộc)
MINIO_ROOT_PASSWORD=
# MinIO server-side encryption key. Generate your own: echo "icss-key:$(openssl rand -base64 32)"
MINIO_KMS_SECRET_KEY=
JWT_SECRET=
JWT_EXPIRATION=
# >= 32 ký tự (backend không khởi động nếu thiếu)
INTERNAL_SERVICE_KEY=
GOOGLE_CLIENT_ID=
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# Địa chỉ web frontend (link đặt lại mật khẩu); bỏ trống thì dùng http://localhost:5173
APP_FRONTEND_BASE_URL=
# Origin được gọi API, phân tách bằng dấu phẩy; bỏ trống thì dùng các cổng dev 5173, 5174, 3000
APP_CORS_ALLOWED_ORIGINS=
# --- Tùy chọn cấu hình triển khai Cloud-Edge (để trống khi chạy Local/Docker mặc định) ---
# Trên Cloud: đặt AI_SERVICE_URL= và MEDIAMTX_API_URL= (chuỗi rỗng) để điều khiển 100% qua MQTT Outbound-Only
AI_SERVICE_URL=
MEDIAMTX_API_URL=
MEDIAMTX_WHEP_BASE_URL=
# Trên Edge: đặt URL RTSP của Cloud MediaMTX khi muốn bật On-Demand Cloud Stream Relay (FFmpeg -c copy)
CLOUD_MEDIAMTX_RTSP_URL=
# Trên Frontend Cloud: đặt HTTPS WHEP endpoint để tránh lỗi Mixed Content trình duyệt
VITE_CLOUD_WHEP_BASE_URL=
VITE_MEDIAMTX_WHEP_BASE_URL=
