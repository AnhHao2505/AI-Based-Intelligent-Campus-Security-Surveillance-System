# Copy thành .env và điền giá trị. KHÔNG commit file .env.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
MINIO_ROOT_USER=
# >= 8 ký tự (AI service bắt buộc)
MINIO_ROOT_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION=
# >= 32 ký tự (backend không khởi động nếu thiếu)
INTERNAL_SERVICE_KEY=
GOOGLE_CLIENT_ID=
KAFKA_CLUSTER_ID=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# Địa chỉ web frontend (link đặt lại mật khẩu); bỏ trống thì dùng http://localhost:5173
APP_FRONTEND_BASE_URL=
# Origin được gọi API, phân tách bằng dấu phẩy; bỏ trống thì dùng các cổng dev 5173, 5174, 3000
APP_CORS_ALLOWED_ORIGINS=
