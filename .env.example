# ============================================
# SEP — Environment Variables (Example Template)
# Copy file này thành .env trên máy local/server
# ============================================

# --- PostgreSQL 16 ---
POSTGRES_USER=sep
POSTGRES_PASSWORD=123456
POSTGRES_DB=campus_security

# --- pgAdmin 4 ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123

# --- MinIO (S3-compatible storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# --- Kafka (KRaft mode) ---
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- JWT Security (24 hours expiration = 86400000 ms) ---
JWT_SECRET=your_super_long_secrets
JWT_EXPIRATION=86400000

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=project_google_client_id_ask_gia_anh

# --- Spring Mail (SMTP Settings) ---
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_password
