@startuml seq-security-report
title Sequence Diagram — 3.13.3 Periodic Security Incident and Access Report Export
skinparam shadowing false
autonumber

actor "Facility Manager" as Actor
participant ":ReportExportView" as View
participant ":ReportController" as Controller
participant ":SecurityReportService" as ReportService
participant ":SecurityReportPdfService" as PdfService
participant ":SecurityIncidentRepository" as IncidentRepo

Actor -> View: Select period (startDate, endDate) and click Export PDF Report
activate View

View -> Controller: requestDownloadReportPdf(startDate, endDate)
activate Controller

Controller -> Controller: validateDateRange(startDate, endDate)

alt Invalid Date Range
    Controller --> View: notifyError("Invalid date range specified")
    View --> Actor: displayErrorMessage()
else Valid Date Range
    Controller -> ReportService: generateReport(startDate, endDate, userEmail)
    activate ReportService

    ReportService -> IncidentRepo: findIncidentsInPeriod(from, to)
    activate IncidentRepo
    IncidentRepo --> ReportService: return incidents
    deactivate IncidentRepo

    ReportService -> ReportService: compileSummaryReport(incidents)

    ReportService --> Controller: return securityReportSummaryDto
    deactivate ReportService

    Controller -> PdfService: generatePdf(securityReportSummaryDto)
    activate PdfService

    PdfService -> PdfService: buildPdfDocumentWithTablesAndKpi(summary)

    PdfService --> Controller: return pdfByteArray
    deactivate PdfService

    Controller --> View: sendPdfFileStream(pdfByteArray, fileName)
    deactivate Controller

    View --> Actor: triggerBrowserDownload(pdfFile)
    deactivate View
end

@enduml
