@startuml use-case-diagram
' Title: UC-01 Use case diagram of ICSSS (one diagram for the whole system)
' Source: frontend/src/App.jsx (routes and roles), backend controllers (@PreAuthorize),
'         mobile/lib/features (Security Officer app), ai-service (check-entry, Kafka alerts, runtime config)
' Presentation version: gen_uc.py -> use-case-diagram.svg / .png (same content, actor-centred layout;
'   AI - UC-05 added 28/10: 2 unavoidable crossings, 0 lines through other use cases). This .puml is the text source of truth.
' Decisions 2026-10-26/27: AI Surveillance Engine is an external actor; no time actor; Google/E-mail not drawn;
'   abstract actor User; only implemented functions; roles as shown in the user interface;
'   layout grouped by actor (27/10) - functional grouping is kept in the SRS UC mapping table, not as packages.
' Layout hint: Administrator top, Facility Manager left, Security Officer and AI right, Authorized User bottom.
top to bottom direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #1F2937
}
skinparam actorStyle awesome
skinparam ArrowColor #475569
title ICSSS — Use Case Diagram

actor "User" as U
actor "Administrator" as AD
actor "Facility Manager" as FM
actor "Authorized User" as AU
actor "Security Officer" as SO
actor "AI Surveillance\nEngine" as AI <<system>>

AD -|> U
FM -|> U
AU -|> U
SO -|> U

rectangle "ICSSS — Intelligent Campus Security Surveillance System" {

  ' --- User (all roles)
  usecase "UC-01 Log In" as UC01
  usecase "UC-02 Reset Password" as UC02
  usecase "UC-03 View Notifications" as UC03

  ' --- Administrator only
  usecase "UC-04 Manage User Accounts" as UC04
  usecase "UC-05 Register Face Data" as UC05
  usecase "UC-06 Configure System Parameters" as UC06
  usecase "UC-07 Manage Reason Catalog" as UC07
  usecase "UC-09 Manage Areas" as UC09
  usecase "UC-10 Manage Cameras" as UC10
  usecase "UC-24 Attach Guest Photo" as UC24

  ' --- Shared by Administrator and Facility Manager
  usecase "UC-08 View Audit Log" as UC08
  usecase "UC-15 View Event Schedules" as UC15
  usecase "UC-16 Search Access History" as UC16
  usecase "UC-32 View Security Dashboard" as UC32

  ' --- Shared by Administrator, Facility Manager and Security Officer
  usecase "UC-31 View Recorded Video" as UC31

  ' --- Shared by Administrator and Security Officer
  usecase "UC-11 View Campus Map" as UC11

  ' --- Facility Manager only
  usecase "UC-12 Change User Access Level" as UC12
  usecase "UC-13 Manage Assigned Personnel" as UC13
  usecase "UC-14 Manage Event Schedules" as UC14
  usecase "UC-20 Review Access Request" as UC20
  usecase "UC-21 Finish or Cancel\nApproved Request" as UC21
  usecase "UC-23 Review Guest Visit" as UC23
  usecase "UC-33 Manage Guard Teams" as UC33
  usecase "UC-34 Plan Guard Shifts" as UC34
  usecase "UC-35 Review Shift Request" as UC35

  ' --- Shared by Facility Manager and Security Officer
  usecase "UC-26 Receive Security Alert" as UC26

  ' --- Shared by Facility Manager and Authorized User
  usecase "UC-22 Invite Guests" as UC22

  ' --- Authorized User only
  usecase "UC-17 View Personal Access History" as UC17
  usecase "UC-18 Request Area Access" as UC18
  usecase "UC-19 Cancel Access Request" as UC19

  ' --- Security Officer only
  usecase "UC-25 Monitor Live Cameras" as UC25
  usecase "UC-27 Acknowledge\nIncident Alert" as UC27
  usecase "UC-28 Claim Incident" as UC28
  usecase "UC-29 Resolve Incident" as UC29
  usecase "UC-30 View Incident\nLocation on Map" as UC30
  usecase "UC-36 Check In and Out of Shift" as UC36
  usecase "UC-37 Request Shift Swap or Leave" as UC37

  ' --- AI Surveillance Engine
  usecase "UC-38 Check Entry Permission" as UC38
  usecase "UC-39 Report Security Incident" as UC39
  usecase "UC-40 Load AI Runtime\nConfiguration" as UC40
}

' --- User (all four roles)
U -- UC01
U -- UC02
U -- UC03

' --- Administrator
AD -- UC04
AD -- UC06
AD -- UC07
AD -- UC08
AD -- UC09
AD -- UC10
AD -- UC11
AD -- UC15
AD -- UC16
AD -- UC24
AD -- UC31
AD -- UC32

' --- Facility Manager
FM -- UC08
FM -- UC12
FM -- UC13
FM -- UC14
FM -- UC15
FM -- UC16
FM -- UC20
FM -- UC21
FM -- UC22
FM -- UC23
FM -- UC26
FM -- UC31
FM -- UC32
FM -- UC33
FM -- UC34
FM -- UC35

' --- Authorized User
AU -- UC17
AU -- UC18
AU -- UC19
AU -- UC22

' --- Security Officer
UC11 -- SO
UC25 -- SO
UC26 -- SO
UC27 -- SO
UC28 -- SO
UC29 -- SO
UC30 -- SO
UC31 -- SO
UC36 -- SO
UC37 -- SO

' --- AI Surveillance Engine (also extracts the face embedding in UC-05, decision 28/10)
UC05 -- AI
UC38 -- AI
UC39 -- AI
UC40 -- AI

' --- Relationships between use cases
UC04 ..> UC05 : <<include>>
UC27 ..> UC26 : <<extend>>
UC30 ..> UC11 : <<extend>>

legend right
  Solid line: the actor takes part in the use case
  Hollow-head solid arrow: generalization (each role is a User)
  <<include>>: always performed as part of the base use case
  <<extend>>: optional behaviour, only under a condition
  Time-based jobs (expiry, auto-finish, escalation) are non-screen functions (SRS 3.1.4), not use cases.
endlegend
@enduml
