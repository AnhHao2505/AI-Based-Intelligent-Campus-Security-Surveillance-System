%% Title: CD-08 Comprehensive Security Monitoring Dashboard VOPC
classDiagram
    direction TB

    class SecurityDashboardController {
        - securityDashboardService : SecurityDashboardService
        + getSecurityStats(range: SecurityStatsRange) : ResponseEntity
    }

    class SecurityDashboardService {
        - securityStatsQueryRepository : SecurityStatsQueryRepository
        - accessLogStatsQueryRepository : AccessLogStatsQueryRepository
        - TOP_AREA_LIMIT : int = 5
        + getStats(range: SecurityStatsRange, now: OffsetDateTime) : SecurityStatsResponse
        - topAreas(from: OffsetDateTime, to: OffsetDateTime) : List~AreaIncidentCount~
        - accessResultsByDay(firstDay: LocalDate, today: LocalDate, ...) : List~DailyAccessResults~
    }

    class SecurityStatsQueryRepository {
        + countByStatus(from: OffsetDateTime, to: OffsetDateTime) : List~StatusCount~
        + countByArea(from: OffsetDateTime, to: OffsetDateTime) : List~AreaCount~
    }

    class AccessLogStatsQueryRepository {
        + countByDayAndResult(from: OffsetDateTime, to: OffsetDateTime, ...) : List~DayResultCount~
    }

    class SecurityStatsResponse {
        + range : SecurityStatsRange
        + from : OffsetDateTime
        + to : OffsetDateTime
        + byStatus : Map~IncidentStatus, Long~
        + resolved : long
        + dismissedRate : Double
        + topAreas : List~AreaIncidentCount~
        + accessResultsByDay : List~DailyAccessResults~
    }

    class AreaIncidentCount {
        + areaId : UUID
        + areaName : String
        + incidentCount : long
    }

    class DailyAccessResults {
        + date : LocalDate
        + counts : Map~AccessResult, Long~
    }

    class SecurityStatsRange {
        + LAST_24_HOURS
        + LAST_7_DAYS
        + LAST_30_DAYS
        + getDays() : int
    }

    SecurityDashboardController --> SecurityDashboardService : invokes
    SecurityDashboardController ..> SecurityStatsResponse : returns

    SecurityDashboardService --> SecurityStatsQueryRepository : queries
    SecurityDashboardService --> AccessLogStatsQueryRepository : queries
    SecurityDashboardService ..> SecurityStatsResponse : creates

    SecurityStatsResponse --> SecurityStatsRange : contains
    SecurityStatsResponse --> AreaIncidentCount : aggregates
    SecurityStatsResponse --> DailyAccessResults : aggregates
