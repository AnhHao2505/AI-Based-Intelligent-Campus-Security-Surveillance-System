@startuml seq-inapp-notification
title Sequence Diagram — 3.14.3 In-App Push Notification Center
skinparam shadowing false
autonumber

actor "Authorized User" as User
participant ":NotificationCenterView" as View
participant ":NotificationController" as Controller
participant ":InAppNotificationService" as Service
participant ":InAppNotificationRepository" as NotifRepo

User -> View: Open notification center and click Mark As Read on an item
activate View

View -> Controller: markNotificationAsRead(notificationId)
activate Controller

Controller -> Service: markAsRead(notificationId, userEmail)
activate Service

Service -> NotifRepo: findById(notificationId)
activate NotifRepo
NotifRepo --> Service: return notification
deactivate NotifRepo

alt Notification Not Found or Access Denied
    Service --> Controller: return not found error
    Controller --> View: notifyError("Notification not found or access denied")
    View --> User: displayErrorMessage()
else Valid Notification
    Service -> Service: updateReadStatus(notification, true, readAt)

    Service -> NotifRepo: save(notification)
    activate NotifRepo
    NotifRepo --> Service: return savedNotification
    deactivate NotifRepo

    Service -> Service: mapToResponse(savedNotification)

    Service --> Controller: return notificationResponse
    deactivate Service

    Controller --> View: sendResponse(notificationResponse)
    deactivate Controller

    View --> User: updateBadgeCountAndMarkItemRead()
    deactivate View
end

@enduml
