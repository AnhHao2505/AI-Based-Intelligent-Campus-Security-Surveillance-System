@startuml seq-reason-catalog
title Sequence Diagram — 3.14.2 Standardized System Reason Catalog Management
skinparam shadowing false
autonumber

actor "Administrator" as Admin
participant ":ReasonCatalogView" as View
participant ":ReasonCatalogController" as Controller
participant ":ReasonCatalogService" as Service
participant ":ReasonCatalogRepository" as Repo

Admin -> View: Fill in new reason details (Code, Label, ActionType) and click Create
activate View

View -> Controller: createReason(createRequest)
activate Controller

Controller -> Service: create(request, actorEmail)
activate Service

Service -> Repo: existsByCodeAndActionType(code, actionType)
activate Repo
Repo --> Service: return codeExists
deactivate Repo

alt Reason Code Already Exists
    Service --> Controller: return duplicate code error
    Controller --> View: notifyError("Reason code already exists for this action type")
    View --> Admin: displayErrorMessage()
else Valid & Unique Code
    Service -> Service: buildReasonCatalogEntity(request, actorEmail)

    Service -> Repo: save(reasonCatalog)
    activate Repo
    Repo --> Service: return savedReasonCatalog
    deactivate Repo

    Service -> Service: recordAuditLog(CREATE, savedReasonCatalog)

    Service --> Controller: return reasonCatalogResponse
    deactivate Service

    Controller --> View: sendResponse(reasonCatalogResponse)
    deactivate Controller

    View --> Admin: renderUpdatedCatalogTable()
    deactivate View
end

@enduml
