stateDiagram-v2
    direction LR

    state "PENDING · awaiting review" as PENDING
    state "APPROVED · grants entry inside window" as APPROVED
    state "REJECTED" as REJECTED
    state "CANCELLED" as CANCELLED
    state "EXPIRED" as EXPIRED
